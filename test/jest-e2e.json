{
  "moduleFileExtensions": ["js", "json", "ts", "mjs"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "@swc/jest",
    "^.+\\.mjs$": "@swc/jest"
  },
  "moduleDirectories": ["<rootDir>/../", "node_modules"],
  "transformIgnorePatterns": ["node_modules/(?!(uuid|graphql-upload)/)"]
}
